# Supabase — only these three are read by app code. The legacy
# Marketplace integration injected an additional 12+ SUPABASE__*
# prefixed env vars (POSTGRES_URL, POSTGRES_PASSWORD, etc.) that
# nothing in the repo references. Pruned during plan-39 phase 4.
#
# Key formats post-migration (plans 39 + 43):
#   NEXT_PUBLIC_SUPABASE_URL       — https://<project-ref>.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY  — sb_publishable_…  (browser-safe; replaces legacy anon JWT, plan 43)
#   SUPABASE_SERVICE_ROLE_KEY      — sb_secret_…       (server-only; replaces legacy service_role JWT, plan 39)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_MONTHLY_PRICE_ID=price_...
STRIPE_ANNUAL_PRICE_ID=price_...
STRIPE_LIFETIME_PRICE_ID=price_...
# LMS — Teacher payout routing
# Comma-separated emails whose courses pay directly to the platform Stripe account (no Connect fees)
PLATFORM_TEACHER_EMAILS=

# Shopify — generates unique single-use shirt promo codes per lifetime member
# SHOPIFY_SHOP_DOMAIN: your store's .myshopify.com URL (e.g. awesomewebstore.myshopify.com)
# SHOPIFY_ADMIN_API_TOKEN: Settings → Apps → Develop apps → Admin API token (needs write_price_rules scope)
# SHOPIFY_PRICE_RULE_ID: ID from Shopify Admin URL when viewing the discount: /admin/discounts/{ID}
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=shpat_...
SHOPIFY_PRICE_RULE_ID=

# Resend — transactional email for admin messages
# Get API key at https://resend.com → API Keys
# RESEND_FROM_EMAIL must be a verified domain in Resend
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=admin@your-domain.com

# Admin dashboard access — only this email can visit /admin
ADMIN_EMAIL=your@email.com
# Same value as ADMIN_EMAIL — needed client-side to bypass paywall for admin
NEXT_PUBLIC_ADMIN_EMAIL=your@email.com

# Public site URL (used in Stripe redirect URLs and email links)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Umami Analytics (optional — privacy-first page & event tracking)
# Get these from your Umami dashboard: Settings → Websites → your site
# Self-hosted: set all three. UMAMI_HOST_URL enables the ad-blocker proxy (server-side only).
# Cloud: set only WEBSITE_ID. Leave SCRIPT_URL and HOST_URL blank.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
UMAMI_HOST_URL=

CLOUDINARY_API_KEY=

# --- Centenarian Coach (multi-agent / LangGraph) ---
# ANTHROPIC_API_KEY: powers the supervisor + specialist agents.
#   Get it at https://console.anthropic.com → Settings → API keys.
ANTHROPIC_API_KEY=
# COACH_LLM_MODEL: Claude model id used by every coach node. Defaults to
#   claude-sonnet-4-6 if unset.
COACH_LLM_MODEL=claude-sonnet-4-6
# LangSmith tracing is OPTIONAL — the coach runs fine without these. When
# LANGSMITH_API_KEY is set, every graph run is traced.
#   Get the key at https://smith.langchain.com → Settings → API keys.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=centenarian-coach
# GOOGLE_GEMINI_API_KEY: Gemini embeddings (gemini-embedding-001 @ 768 dims)
#   for the coach knowledge-base retrieval and the existing help/RAG chat.
#   Get it at https://aistudio.google.com/apikey
GOOGLE_GEMINI_API_KEY=
# The coach also reuses the Supabase keys above — no new Supabase vars needed.

# --- WitUS ecosystem integration ---
# Inbox (inbound): user feedback/help/bug is mirrored to BAM's one triage
# dashboard (inbox.witus.online -> Triage). Slug "centenarian-os". Non-blocking;
# if unset, the app still stores feedback locally and just skips the mirror.
INBOX_INGEST_URL=https://inbox.witus.online/api/ingest
INBOX_SOURCE_SLUG=centenarian-os
INBOX_INGEST_SECRET=
# Outbox (outbound): social-post drafts to BAM's accounts via the WitUS Outbox
# (outbox.witus.online). Same slug. Wired via lib/sender-outbox.ts when used.
OUTBOX_INGEST_URL=https://outbox.witus.online/api/ingest
OUTBOX_SOURCE_SLUG=centenarian-os
OUTBOX_INGEST_SECRET=
OUTBOX_TRIGGER_ENABLED=true

# "Sign in with WitUS" — ecosystem SSO ("Option A", the shared IdP at accounts.witus.online).
# Bespoke OIDC code flow: app/api/auth/witus/authorize -> IdP -> .../witus/callback, which mints a
# normal Supabase session. Two extra features ride on the SAME client id:
#   * the login page's silent "Continue as <name>" probe, and
#   * global sign-out (signing out here ends the shared session at the IdP, so it signs you out of
#     every WitUS app in this browser).
# BOTH STAY COMPLETELY DARK unless WITUS_OIDC_CLIENT_ID is set — the "Sign in with WitUS" button
# does not render at all and sign-out is purely local. An affordance the visitor cannot complete is
# worse than none.
#   WITUS_OIDC_CLIENT_ID / WITUS_OIDC_CLIENT_SECRET — issued by the IdP registry
#     (gemini/witus lib/identity/clients.ts). Server-only; never expose with NEXT_PUBLIC_.
WITUS_OIDC_CLIENT_ID=
WITUS_OIDC_CLIENT_SECRET=
# Optional endpoint overrides. Defaults are the live IdP's; the authorize URL is the ONE place the
# ecosystem host is asserted — lib/auth/witus-sso.ts derives the endsession and session-probe URLs
# from it, so overriding it moves the whole flow to another IdP.
# WITUS_OIDC_AUTHORIZE_URL=https://accounts.witus.online/api/idp/oauth2/authorize
# WITUS_OIDC_TOKEN_URL=https://accounts.witus.online/api/idp/oauth2/token
# WITUS_OIDC_USERINFO_URL=https://accounts.witus.online/api/idp/oauth2/userinfo
# Optional — overrides the derived "who is signed in?" probe endpoint. That path is owned by the
# IdP app, not by this one, so an explicit value wins over the derived default.
# WITUS_SSO_SESSION_URL=https://accounts.witus.online/api/ecosystem/session

# Learn.WitUS -> CentOS metrics deep-link handoff ("Option B", signed deep-link).
# Learn.WitUS mints a short-lived HS256 JWT with this SAME shared secret; CentOS
# verifies it at /api/auth/witus/handoff and logs the learner straight into the
# metrics module. See docs/integrations/centos-read-your-body-data.md.
#   WITUS_HANDOFF_SECRET — the shared HMAC secret. Generate >=32 random bytes
#     (e.g. `openssl rand -base64 48`) and set the IDENTICAL value in Learn.WitUS.
#     Server-only; never expose with NEXT_PUBLIC_. If unset, the route is disabled.
WITUS_HANDOFF_SECRET=

# Work.WitUS -> CentOS income events (Stage 2, Phase 2 of the database split).
# Work.WitUS signs each income event with this shared secret and POSTs it to
# /api/events/income; CentOS upserts it into the local income_events projection that the
# finance forecast and planner read. This replaces CentOS reading the cross-app
# expected_payments VIEW. See plans/55-stage2-db-split.md.
#   INCOME_EVENTS_SECRET — shared HMAC secret. Generate >=32 random bytes
#     (e.g. `openssl rand -hex 32`) and set the IDENTICAL value in Work.WitUS as
#     INCOME_EVENTS_SECRET. Server-only; never expose with NEXT_PUBLIC_.
#     If unset, /api/events/income returns 503 and the forecast keeps reading the
#     legacy view, so leaving it blank is safe until the emitter is deployed.
INCOME_EVENTS_SECRET=

# RideWitUS <-> CentOS, server to server (RideWitUS PRD §6.5, §6.9, §6.10; README "Optional:
# RideWitUS integration"). Same X-Witus-* signing as above; a GET signs its path + query string.
# One secret per endpoint so each can be rotated alone. Generate each with `openssl rand -hex 32`
# and set the IDENTICAL value under the SAME name in RideWitUS. Server-only; never NEXT_PUBLIC_.
#   RIDE_VENDOR_API_SECRET          RideWitUS -> GET /api/v1/ride/vendors... (unset: 503)
#   RIDE_RESYNC_SECRET              RideWitUS -> POST /api/v1/ride/resync    (unset: 503)
#   ENVELOPE_BALANCE_EVENTS_URL     CentOS -> RideWitUS: the full URL of RideWitUS's
#                                   /api/events/envelope-balance receiver on its deployment
#   ENVELOPE_BALANCE_EVENTS_SECRET  the secret that receiver checks
# With the URL or secret unset, envelope.balance is a logged no-op. Needs migration 217.
RIDE_VENDOR_API_SECRET=
RIDE_RESYNC_SECRET=
ENVELOPE_BALANCE_EVENTS_URL=
ENVELOPE_BALANCE_EVENTS_SECRET=
# Optional: X-Witus-Source on outgoing events. Default 'centenarianos' (the slug in
# gemini/witus/lib/products.ts); set it only if the receiver expects another value.
# WITUS_SOURCE_SLUG=centenarianos
# Optional — must match the iss/aud Learn.WitUS stamps into the token. Defaults below.
WITUS_HANDOFF_ISS=learn.witus.online
WITUS_HANDOFF_AUD=centenarian-os

# --- Error monitoring (Better Stack, via the Sentry SDK) ---
# ALL OPTIONAL. With none of these set the SDK never initializes and the app
# behaves exactly as it did before error monitoring was wired up.
# Better Stack speaks the Sentry protocol, so its "Sentry DSN" is what goes here:
#   Better Stack -> Telemetry -> Sources -> your source -> Sentry-compatible DSN.
#   SENTRY_DSN: server + edge runtimes (server-only).
#   NEXT_PUBLIC_SENTRY_DSN: browser runtime. Public by design (a DSN only lets
#     the holder SEND events), but it is a separate var so you can enable server
#     reporting without enabling browser reporting.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional label on each event. Falls back to VERCEL_ENV, then NODE_ENV.
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Build-time source-map upload only. Without SENTRY_AUTH_TOKEN the build skips
# BOTH generating and uploading source maps, and you get minified stack traces.
# Nothing fails. Generating maps nobody can receive is what helped OOM the Vercel
# build, so next.config.mjs gates the whole source-map path on this token.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Stored-secret encryption (lib/crypto/tokens.ts) ---
# AES-256-GCM key for third-party tokens stored in the database: 64 hex characters, from `openssl rand -hex 32`.
# Read by the Google Calendar connection (below), which stores its OAuth tokens encrypted with it.
# Changing the key makes every stored token unreadable: each user then has to disconnect and connect again.
TOKEN_ENCRYPTION_KEY=

# --- Google Calendar, one-way sync: Google -> CentenarianOS (lib/google/, /dashboard/settings/calendar) ---
# Optional. Without these the settings page says Google Calendar is not available and shows no Connect button.
# Create them in Google Cloud Console: enable the Google Calendar API, configure the OAuth consent screen,
# then create an OAuth client of type "Web application".
#   GOOGLE_OAUTH_CLIENT_ID      the client ID of that OAuth client
#   GOOGLE_OAUTH_CLIENT_SECRET  its client secret (server-only; never NEXT_PUBLIC_)
# Authorized redirect URI to register on the OAuth client, once per origin the app is served from
# (it must match exactly: scheme, host, no trailing slash):
#   <origin>/api/calendar/google/callback     e.g. http://localhost:3000/api/calendar/google/callback
# The app builds this from the origin of the request, so there is no URL to configure here.
# The connection also needs TOKEN_ENCRYPTION_KEY (above), SUPABASE_JWT_SECRET (below) and
# migration 204_calendar_sync.sql. README: "Optional: Google Calendar (one-way sync)".
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Calendar activity feed to RideWitUS (lib/ridewitus/, RideWitUS PRD §6.5a) ---
# Optional. Without both, nothing is sent to RideWitUS and the sync works as before.
# After each calendar sync, events from calendars the user shares with RideWitUS (Calendar Sync,
# off by default) that have a location are POSTed as signed `calendar.activity` events
# (X-Witus-Source: centenarianos, HMAC-SHA256 over `${timestamp}.${rawBody}`).
#   RIDEWITUS_CALENDAR_ACTIVITY_URL   full URL of RideWitUS's receiver, POST /api/events/calendar-activity
#                                     (take it from the RideWitUS deployment; there is no default)
#   CALENDAR_ACTIVITY_EVENTS_SECRET   shared secret; the SAME value is set on RideWitUS. Server-only.
#                                     e.g. `openssl rand -hex 32`
# Needs migration 216_calendar_activity_feed.sql. README: "Calendar activity feed to RideWitUS".
RIDEWITUS_CALENDAR_ACTIVITY_URL=
CALENDAR_ACTIVITY_EVENTS_SECRET=

# --- OAuth state signing (lib/oauth-state.ts) ---
# HMAC key that signs the `state` value of the OAuth connect flows (Google Calendar, wearables),
# so a callback can be tied to the user who started it. Server-only. lib/oauth-state.ts is the only
# code that reads it, and any long random secret works (e.g. `openssl rand -hex 32`); it only has to
# be the same value when the user leaves for the provider and when they come back. When it is unset,
# the Google Calendar settings page shows no Connect button.
# Signs the OAuth `state` for wearables and Google Calendar (lib/oauth-state.ts). The Vercel-Supabase
# integration provides it as SUPABASE__SUPABASE_JWT_SECRET; either name works.
SUPABASE_JWT_SECRET=
